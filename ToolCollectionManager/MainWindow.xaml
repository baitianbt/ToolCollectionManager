<Window x:Class="ToolCollectionManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:ViewModels="clr-namespace:ToolCollectionManager.ViewModels"
        xmlns:Views="clr-namespace:ToolCollectionManager.Views"
        xmlns:converters="clr-namespace:ToolCollectionManager.Converters"
        mc:Ignorable="d"
        Title="{Binding Title}" Height="768" Width="1280"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        TextElement.FontWeight="Regular"
        TextElement.FontSize="14"
        TextElement.FontFamily="{materialDesign:MaterialDesignFont}"
        Background="{DynamicResource MaterialDesignPaper}"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="CanResize">
    
    <Window.Resources>
        <converters:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>
    </Window.Resources>

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="32"
                      ResizeBorderThickness="5"
                      GlassFrameThickness="0"
                      CornerRadius="0" />
    </WindowChrome.WindowChrome>

    <materialDesign:DialogHost IsOpen="{Binding IsDialogOpen}" DialogContent="{Binding DialogContent}" CloseOnClickAway="True">
        <materialDesign:DialogHost.Resources>
             <DataTemplate DataType="{x:Type ViewModels:SoftwareDetailViewModel}">
                 <Views:SoftwareDetailView />
             </DataTemplate>
             <DataTemplate DataType="{x:Type ViewModels:SoftwareEditViewModel}">
                 <Views:SoftwareEditView />
             </DataTemplate>
             <DataTemplate DataType="{x:Type ViewModels:CategoryManagementViewModel}">
                 <Views:CategoryManagementView />
             </DataTemplate>
             <DataTemplate DataType="{x:Type ViewModels:SettingsViewModel}">
                 <Views:SettingsView />
             </DataTemplate>
             <DataTemplate DataType="{x:Type ViewModels:LoadingViewModel}">
                 <Views:LoadingView />
             </DataTemplate>
        </materialDesign:DialogHost.Resources>
        
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Title Bar -->
                <RowDefinition Height="Auto"/> <!-- Toolbar/Filter -->
                <RowDefinition Height="*"/>    <!-- Content -->
            </Grid.RowDefinitions>

            <!-- Custom Title Bar -->
            <Grid Grid.Row="0" Background="{DynamicResource PrimaryHueMidBrush}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- App Icon & Title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="8,0,0,0" VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="Toolbox" Width="20" Height="20" Foreground="{DynamicResource PrimaryHueMidForegroundBrush}" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding Title}" Margin="8,0,0,0" VerticalAlignment="Center" 
                               Foreground="{DynamicResource PrimaryHueMidForegroundBrush}" 
                               FontWeight="Medium"/>
                </StackPanel>

                <!-- Window Buttons -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True">
                    <!-- Settings Button -->
                    <Button Style="{StaticResource MaterialDesignIconForegroundButton}"
                            ToolTip="设置"
                            Command="{Binding OpenSettingsCommand}"
                            Foreground="{DynamicResource PrimaryHueMidForegroundBrush}"
                            Width="40" Height="32" Margin="0,0,8,0">
                        <materialDesign:PackIcon Kind="Cog" Width="20" Height="20" />
                    </Button>

                    <Button Style="{StaticResource MaterialDesignFlatButton}" 
                            Foreground="{DynamicResource PrimaryHueMidForegroundBrush}"
                            Padding="0" Width="46" Height="32"
                            Click="MinimizeButton_Click">
                        <materialDesign:PackIcon Kind="WindowMinimize" />
                    </Button>
                    <Button Style="{StaticResource MaterialDesignFlatButton}" 
                            Foreground="{DynamicResource PrimaryHueMidForegroundBrush}"
                            Padding="0" Width="46" Height="32"
                            Click="MaximizeButton_Click">
                        <materialDesign:PackIcon Kind="WindowMaximize" />
                    </Button>
                    <Button Style="{StaticResource MaterialDesignFlatButton}" 
                            Foreground="{DynamicResource PrimaryHueMidForegroundBrush}"
                            Padding="0" Width="46" Height="32"
                            Click="CloseButton_Click"
                            materialDesign:ButtonAssist.CornerRadius="0">
                        <materialDesign:PackIcon Kind="WindowClose" />
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Toolbar / Filter Area -->
            <materialDesign:ColorZone Grid.Row="1" Mode="Standard" Padding="16" materialDesign:ElevationAssist.Elevation="Dp2">
                <StackPanel Orientation="Horizontal">
                    <!-- Search Box -->
                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             materialDesign:HintAssist.Hint="搜索工具..."
                             materialDesign:TextFieldAssist.HasClearButton="True"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             Width="300"
                             VerticalAlignment="Center"
                             Margin="0,0,16,0"/>
                    
                    <!-- Category Filter -->
                    <ComboBox ItemsSource="{Binding Categories}" 
                              SelectedItem="{Binding SelectedCategory}"
                              DisplayMemberPath="Name"
                              materialDesign:HintAssist.Hint="全部分类"
                              Width="200"
                              VerticalAlignment="Center"
                              Style="{StaticResource MaterialDesignOutlinedComboBox}"
                              Margin="0,0,16,0"/>

                </StackPanel>
            </materialDesign:ColorZone>

            <!-- Main Content -->
            <Grid Grid.Row="2">
                <ScrollViewer Padding="16" Background="{DynamicResource MaterialDesignPaper}">
                    <ItemsControl ItemsSource="{Binding SoftwareItems}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <materialDesign:Card Width="180" Height="180" Margin="12" UniformCornerRadius="16" 
                                                     materialDesign:ElevationAssist.Elevation="Dp2"
                                                     materialDesign:RippleAssist.IsDisabled="False"
                                                     Cursor="Hand"
                                                     ToolTip="{Binding Description}">
                                    <materialDesign:Card.RenderTransform>
                                        <ScaleTransform ScaleX="1" ScaleY="1" CenterX="90" CenterY="90"/>
                                    </materialDesign:Card.RenderTransform>
                                    <materialDesign:Card.Style>
                                        <Style TargetType="materialDesign:Card" BasedOn="{StaticResource {x:Type materialDesign:Card}}">
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Trigger.EnterActions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" To="1.05" Duration="0:0:0.2"/>
                                                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" To="1.05" Duration="0:0:0.2"/>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </Trigger.EnterActions>
                                                    <Trigger.ExitActions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" To="1" Duration="0:0:0.2"/>
                                                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" To="1" Duration="0:0:0.2"/>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </Trigger.ExitActions>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </materialDesign:Card.Style>
                                    
                                    <materialDesign:Card.InputBindings>
                                        <MouseBinding MouseAction="LeftClick" 
                                                      Command="{Binding DataContext.LaunchSoftwareCommand, RelativeSource={RelativeSource AncestorType=Window}}" 
                                                      CommandParameter="{Binding}" />
                                    </materialDesign:Card.InputBindings>
                                    <Grid>
                                        <!-- Content -->
                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <!-- Icon -->
                                             <Grid Width="80" Height="80" Margin="0,0,0,12">
                                                 <materialDesign:PackIcon Kind="Application" Width="80" Height="80" 
                                                                          Foreground="{DynamicResource PrimaryHueLightBrush}"
                                                                          Visibility="{Binding IconPath, Converter={StaticResource StringToVisibilityConverter}, ConverterParameter=Inverse}"/>
                                                 <Image Source="{Binding IconPath}" Stretch="Uniform" 
                                                        RenderOptions.BitmapScalingMode="HighQuality"
                                                        Visibility="{Binding IconPath, Converter={StaticResource StringToVisibilityConverter}}"/>
                                             </Grid>
                                             
                                             <!-- Name -->
                                             <TextBlock Text="{Binding Name}" 
                                                        HorizontalAlignment="Center" TextAlignment="Center"
                                                        FontSize="16" FontWeight="Bold" 
                                                        TextWrapping="Wrap" MaxHeight="40" TextTrimming="CharacterEllipsis"
                                                        Margin="8,0,8,4"/>
                                             
                                             <!-- Description -->
                                             <TextBlock Text="{Binding Description}" 
                                                        HorizontalAlignment="Center" TextAlignment="Center"
                                                        FontSize="12" Opacity="0.6"
                                                        TextWrapping="Wrap" MaxHeight="36" TextTrimming="CharacterEllipsis"
                                                        Margin="8,0"/>
                                        </StackPanel>
                                    </Grid>
                                </materialDesign:Card>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Loading Overlay -->
                <Grid Background="#80000000" Visibility="{Binding IsLaunching, Converter={StaticResource BooleanToVisibilityConverter}}"
                      d:Visibility="Visible">
                    <materialDesign:Card UniformCornerRadius="8" Padding="32" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <StackPanel>
                            <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}" 
                                         IsIndeterminate="True" 
                                         Value="0" 
                                         Width="50" Height="50"
                                         Margin="0,0,0,16"/>
                            <TextBlock Text="正在启动应用..." HorizontalAlignment="Center" FontWeight="Medium"/>
                        </StackPanel>
                    </materialDesign:Card>
                </Grid>
            </Grid>
        </Grid>
    </materialDesign:DialogHost>
</Window>